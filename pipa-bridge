#!/usr/bin/python3 -I
"""Lets Home Assistant's voice assistant talk to PiPA (nanobot).

Home Assistant's llama.cpp integration speaks the OpenAI chat API and sends the whole
conversation on every turn; nanobot's API takes one user message per request and keeps the
history itself, per session. In between, this:

- forwards only the newest user message, marked "(por voz; agora é ...)", so PiPA answers
  briefly and knows the date and time (the model otherwise guesses, wrongly);
- uses Home Assistant's conversation ID (the request's `user` field) as nanobot's session, so
  a follow-up question keeps its context;
- strips markdown and emojis from the reply, since the voice reads everything aloud;
- answers Home Assistant's setup check ("What is the capital of France?") itself.

Listens on 127.0.0.1:8901 (PIPA_BRIDGE_PORT). In Home Assistant: add the llama.cpp
integration with the URL http://127.0.0.1:8901/v1.
"""

import json
import logging
import os
import re
import sys
import time
import urllib.error
import urllib.request
import uuid
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = int(os.environ.get("PIPA_BRIDGE_PORT", "8901"))
NANOBOT = os.environ.get("PIPA_API_URL", "http://127.0.0.1:8900/v1/chat/completions")
API_KEY = os.environ.get("PIPA_API_KEY", "")
TIMEOUT = 300
MODEL = "pipa"

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s", stream=sys.stdout)
log = logging.getLogger("pipa-bridge")

EMOJI = re.compile("[\U0001F000-\U0001FAFF☀-➿️‍]")
WEEKDAYS = ["segunda-feira", "terça-feira", "quarta-feira", "quinta-feira", "sexta-feira", "sábado", "domingo"]
MONTHS = ["janeiro", "fevereiro", "março", "abril", "maio", "junho", "julho", "agosto", "setembro",
          "outubro", "novembro", "dezembro"]


def now_spoken():
    """The Pi's local date and time, in Portuguese, without depending on the system locale."""
    now = datetime.now().astimezone()
    return f"{WEEKDAYS[now.weekday()]}, {now.day} de {MONTHS[now.month - 1]} de {now.year}, {now:%H:%M}"


def for_voice(text):
    """The reply without markdown or emojis, as one paragraph."""
    text = re.sub(r"```.*?```", "", text, flags=re.S)
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)          # [link](url) -> link
    text = re.sub(r"^\s{0,3}(#+|[-*+]|\d+[.)])\s+", "", text, flags=re.M)  # headings, bullets
    text = re.sub(r"[*_`~]+", "", text)
    text = EMOJI.sub("", text)
    return re.sub(r"\s*\n\s*", " ", text).strip()


def last_user_text(messages):
    for message in reversed(messages):
        if message.get("role") != "user":
            continue
        content = message.get("content")
        if isinstance(content, list):  # [{"type": "text", "text": ...}, ...]
            content = " ".join(p.get("text", "") for p in content if isinstance(p, dict))
        return (content or "").strip()
    return ""


def ask_pipa(text, session):
    body = json.dumps({"messages": [{"role": "user", "content": f"(por voz; agora é {now_spoken()}) {text}"}],
                       "session_id": session}).encode()
    headers = {"Content-Type": "application/json"}
    if API_KEY:
        headers["Authorization"] = f"Bearer {API_KEY}"
    request = urllib.request.Request(NANOBOT, body, headers)
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        reply = json.load(response)
    return reply["choices"][0]["message"].get("content") or ""


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path.rstrip("/") == "/v1/models":
            self.send_json({"object": "list",
                            "data": [{"id": MODEL, "object": "model", "owned_by": "pipa", "created": 0}]})
        else:
            self.send_json({"error": {"message": "not found"}}, 404)

    def do_POST(self):
        if self.path.rstrip("/") != "/v1/chat/completions":
            return self.send_json({"error": {"message": "not found"}}, 404)
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        text = last_user_text(body.get("messages", []))
        stream = bool(body.get("stream"))
        if body.get("max_tokens") == 3 and text == "What is the capital of France?":
            return self.reply("Paris.", stream)  # Home Assistant's setup check
        session = f"voz:{body.get('user') or 'sem-conversa'}"
        start = time.monotonic()
        try:
            answer = for_voice(ask_pipa(text, session))
        except (urllib.error.URLError, TimeoutError, KeyError, ValueError) as err:
            log.warning("PiPA didn't answer: %s", err)
            return self.send_json({"error": {"message": f"PiPA didn't answer: {err}"}}, 502)
        log.info("%s: %.1f s: %r -> %r", session, time.monotonic() - start, text[:60], answer[:80])
        self.reply(answer, stream)

    def reply(self, text, stream):
        base = {"id": f"chatcmpl-{uuid.uuid4().hex[:24]}", "created": int(time.time()), "model": MODEL}
        if not stream:
            return self.send_json({**base, "object": "chat.completion", "choices": [{
                "index": 0, "finish_reason": "stop",
                "message": {"role": "assistant", "content": text}}],
                "usage": {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}})
        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream")
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        chunk = {**base, "object": "chat.completion.chunk"}
        for delta, finish in (({"role": "assistant", "content": text}, None), ({}, "stop")):
            event = {**chunk, "choices": [{"index": 0, "delta": delta, "finish_reason": finish}]}
            self.wfile.write(f"data: {json.dumps(event, ensure_ascii=False)}\n\n".encode())
        self.wfile.write(b"data: [DONE]\n\n")

    def send_json(self, data, status=200):
        payload = json.dumps(data, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, format, *args):
        pass  # one line per conversation turn is logged above instead


if __name__ == "__main__":
    log.info("listening on 127.0.0.1:%d, PiPA at %s", PORT, NANOBOT)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
