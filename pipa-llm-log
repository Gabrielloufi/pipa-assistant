def norm_tag(tag):
    tag = unicodedata.normalize("NFKD", (tag or "").strip().lower().lstrip("#"))
    tag = "".join(ch for ch in tag if not unicodedata.combining(ch))
    return re.sub(r"[\s_]+", "-", tag).strip("-")


def render_links(query):
    """The link catalog pipa_links keeps, as a table: filter by tag or kind, search words."""
    tag, kind = norm_tag((query.get("tag") or [""])[0]), (query.get("kind") or [""])[0]
    words = [w for w in re.findall(r"\w+", (query.get("q") or [""])[0].lower()) if len(w) >= 3][:8]
    rows, counts, total = [], {}, 0
    if LINKS_DB.exists():
        db = sqlite3.connect(f"file:{LINKS_DB}?mode=ro", uri=True)
        try:
            total = db.execute("select count(*) from links").fetchone()[0]
            for (tags,) in db.execute("select tags from links"):
                for t in filter(None, (tags or "").split(",")):
                    counts[t] = counts.get(t, 0) + 1
            where, args, source = [], [], "links l"
            if tag:
                where.append("',' || l.tags || ',' like ?")
                args.append(f"%,{tag},%")
            if kind:
                where.append("l.kind = ?")
                args.append(kind)
            if words:
                source = "links l join links_fts on links_fts.rowid = l.id"
                where.append("links_fts match ?")
                args.append(" OR ".join(f'"{w}"*' for w in words))
            order = "bm25(links_fts), l.added desc" if words else "l.added desc"
            rows = db.execute(f"select l.url, l.title, l.summary, l.kind, l.tags, l.note, l.added from {source}"
                              f"{' where ' + ' and '.join(where) if where else ''} order by {order} limit 500",
                              args).fetchall()
        finally:
            db.close()
    chips = [f'<a class="tag{"" if tag else " on"}" href="links">todas ({total})</a>']
    chips += [f'<a class="tag{" on" if t == tag else ""}" href="links?tag={html.escape(t)}">{html.escape(t)} ({n})</a>'
              for t, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))]
    body = []
    for url, title, summary, kind_, tags, note, added in rows:
        safe = url if url.startswith(("http://", "https://")) else "#"
        tag_links = " ".join(f'<a class="tag" href="links?tag={html.escape(t)}">{html.escape(t)}</a>'
                             for t in filter(None, (tags or "").split(",")))
        note_html = f'<div class="note">comentário: {html.escape(note)}</div>' if note else ""
        body.append(f'<tr><td class="date meta">{added[8:10]}/{added[5:7]}/{added[:4]}</td>'
                    f'<td class="title"><a href="{html.escape(safe)}" target="_blank" rel="noopener noreferrer">'
                    f'{html.escape(title or url)}</a><div class="meta">{html.escape(kind_ or "")}</div></td>'
                    f'<td>{tag_links}</td><td class="summary">{html.escape(summary or "")}{note_html}</td></tr>')
    shown = (f"{len(rows)} de {total} links" if (tag or kind or words) else f"{total} links") if total else "Nenhum link ainda: mande um para a PiPA no Telegram."
    table = ('<table><thead><tr><th>Data</th><th>Título</th><th>Tags</th><th>Resumo</th></tr></thead>'
             f'<tbody>{"".join(body)}</tbody></table>') if body else ""
    q = html.escape(" ".join(words))
    return (f'<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" '
            f'content="width=device-width, initial-scale=1"><title>PiPA: links salvos</title>'
            f'<style>{PAGE_STYLE}{LINKS_STYLE}</style></head><body><main><h1>PiPA: links salvos</h1>{NAV}'
            f'<form class="search" method="get" action="links"><input name="q" value="{q}" '
            f'placeholder="buscar no título, resumo ou comentário"><button>Buscar</button></form>'
            f'<div class="tags">{"".join(chips)}</div><p class="sub">{shown}</p>{table}</main></body></html>')


class Page(BaseHTTPRequestHandler):
    def do_GET(self):
        url = urlsplit(self.path)
        limit = min(int((parse_qs(url.query).get("limit") or ["400"])[0]), 5000)
        prompt = re.fullmatch(r"/prompt/([0-9a-f]{12})", url.path)
        if url.path == "/api/calls":
            calls = [{**c, "source": source_of(c)} for c in read_calls(limit)]
            data, kind = json.dumps(calls, ensure_ascii=False).encode(), "application/json"
        elif prompt and (PROMPTS / f"{prompt.group(1)}.txt").exists():
            data, kind = (PROMPTS / f"{prompt.group(1)}.txt").read_bytes(), "text/plain; charset=utf-8"
        elif url.path == "/links":
            data, kind = render_links(parse_qs(url.query)).encode(), "text/html; charset=utf-8"
        elif url.path == "/":
            data, kind = render(read_calls(limit)).encode(), "text/html; charset=utf-8"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, format, *args):
        pass


