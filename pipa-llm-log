CLAIM = re.compile(r"\b(agendei|anotei|liguei|desliguei|criei|marquei|lembrete criado)\b", re.I)


def render(calls):
    rows = []
    for c in calls:
        tools = c.get("tool_calls") or []
        did = " ".join(f'<span class="tool">→ {html.escape(t.get("name") or "?")}({html.escape((t.get("arguments") or "")[:120])})</span>'
                       for t in tools)
        reply = c.get("content") or ""
        claims_without_tool = not tools and not c.get("after_tool") and CLAIM.search(reply)
        flag = '<span class="flag">says it did something, with no tool call</span>' if claims_without_tool else ""
        offered = c.get("tools") or []
        usage = c.get("usage") or {}
        meta = (f'{html.escape(c.get("time", ""))} · {html.escape(str(c.get("channel")))} · {html.escape(str(c.get("model")))}'
                f' · {c.get("seconds", "?")} s · {usage.get("prompt_tokens", "?")}→{usage.get("completion_tokens", "?")} tok'
                f' · {len(offered)} tools{" (cron)" if "cron" in offered else ""}')
        if c.get("system_prompt"):
            meta += f' · <a href="prompt/{html.escape(c["system_prompt"])}">prompt</a>'
        user = "(continues after a tool result)" if c.get("after_tool") else c.get("user", "")
        rows.append(
            f'<details><summary><span class="meta">{meta}</span>'
            f'<span class="user"><span class="who">Você:</span> {html.escape(user[:300])}</span>'
            f'<span class="user"><span class="who">Modelo:</span> {did} {html.escape(reply[:300])} {flag}</span></summary>'
            f'<pre>{html.escape(json.dumps(c, ensure_ascii=False, indent=2))}</pre></details>')
    body = "".join(rows) or "<p>Nada registrado ainda.</p>"
    return (f'<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" '
            f'content="width=device-width, initial-scale=1"><title>PiPA: chamadas ao modelo</title>'
            f'<style>{PAGE_STYLE}</style></head><body><main><h1>PiPA: chamadas ao modelo</h1>'
            f'<p class="sub">As mais recentes primeiro. Cada linha é uma chamada ao modelo de linguagem; '
            f'uma mensagem sua pode gerar várias (ferramenta, depois resposta). Clique para ver tudo.</p>'
            f'{body}</main></body></html>')


class Page(BaseHTTPRequestHandler):
    def do_GET(self):
        url = urlsplit(self.path)
        limit = min(int((parse_qs(url.query).get("limit") or ["100"])[0]), 2000)
        prompt = re.fullmatch(r"/prompt/([0-9a-f]{12})", url.path)
        if url.path == "/api/calls":
            data, kind = json.dumps(read_calls(limit), ensure_ascii=False).encode(), "application/json"
        elif prompt and (PROMPTS / f"{prompt.group(1)}.txt").exists():
            data, kind = (PROMPTS / f"{prompt.group(1)}.txt").read_bytes(), "text/plain; charset=utf-8"
        elif url.path == "/":
            data, kind = render(read_calls(limit)).encode(), "text/html; charset=utf-8"
        else:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", kind)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    page = ThreadingHTTPServer(("127.0.0.1", PAGE_PORT), Page)
    threading.Thread(target=page.serve_forever, daemon=True).start()
    print(f"proxy 127.0.0.1:{PROXY_PORT} -> {UPSTREAM.geturl()} | page 127.0.0.1:{PAGE_PORT}", flush=True)
    ThreadingHTTPServer(("127.0.0.1", PROXY_PORT), Proxy).serve_forever()
