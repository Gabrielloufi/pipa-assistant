GAP = timedelta(minutes=15)  # a longer pause starts a new block
# Claude's test conversations are named "teste-..." (through the bridge or the API) or
# "bench-..." (pipa-gabe/bench); nanobot's own prompts are recognized by their wording.
TEST_SESSION = re.compile(r"(^|[:_-])(teste|bench)", re.I)
INTERNAL = [("catálogo de links", re.compile(r"^\[catálogo de links\]", re.M)),
            ("Dream (memória de longo prazo)", re.compile(r"You are running Dream", re.I)),
            ("resumo da conversa", re.compile(r"compact replacement checkpoint|retained fact|summar", re.I))]
SOURCES = {"you": "Você", "claude": "Claude (testes)", "pipa": "PiPA (por conta própria)"}
CLAIM = re.compile(r"\b(agendei|anotei|liguei|desliguei|criei|marquei|lembrete criado)\b", re.I)


def last_user_text(c):
    for m in reversed(c.get("messages_tail") or []):
        if m.get("role") == "user":
            return m.get("content") or ""
    return c.get("user") or ""


def internal_kind(c):
    text = last_user_text(c)
    return next((kind for kind, pattern in INTERNAL if pattern.search(text)), None)


def is_subcall(c):
    """A tool's own call to the model on behalf of a conversation (pipa_links summarizing a
    page): it carries that conversation's session and shows inside it."""
    return bool(c.get("session")) and internal_kind(c) == "catálogo de links"


def source_of(c):
    """Who started a call: you (Telegram, or Home Assistant's voice later), Claude testing
    PiPA, or PiPA on its own (Dream, memory, a reminder firing)."""
    session = c.get("session") or ""
    turn = c.get("turn")
    if turn is None:  # logged before "turn" was recorded
        turn = "Channel:" in last_user_text(c)
    if c.get("channel") in ("terminal", "teste", "?") or TEST_SESSION.search(session):
        return "claude"
    if session.startswith(("cron", "heartbeat", "dream", "system")):
        return "pipa"
    if is_subcall(c):
        return "you"
    if internal_kind(c):
        return "pipa"
    if c.get("channel") == "voz" and not session:  # before sessions were logged, only Claude used voice
        return "claude"
    return "you" if turn else "pipa"


def label_of(c, source):
    if source == "pipa":
        session = c.get("session") or ""
        return internal_kind(c) or ("lembrete" if session.startswith("cron") else "tarefa")
    return {"telegram": "Telegram", "voz": "voz", "terminal": "terminal", "?": "API"}.get(
        c.get("channel"), str(c.get("channel")))


def blocks_of(calls):
    """Calls, oldest first, gathered into conversation blocks: same source and conversation,
    no pause over GAP. Each block holds turns: a message and the calls it caused."""
    open_blocks, blocks = {}, []
    for c in calls:
        source = source_of(c)
        label = label_of(c, source)
        key = (source, c.get("session") or label)
        when = datetime.fromisoformat(c["time"])
        block = open_blocks.get(key)
        if block is None or when - block["last"] > GAP:
            block = {"source": source, "label": label, "first": when, "turns": []}
            open_blocks[key] = block
            blocks.append(block)
        block["last"] = when
        if (c.get("after_tool") or is_subcall(c)) and block["turns"]:
            block["turns"][-1].append(c)
        else:
            block["turns"].append([c])
    return sorted(blocks, key=lambda b: b["last"], reverse=True)


def tool_line(t):
    return (f'<div class="step">→ <span class="tool">{html.escape(t.get("name") or "?")}'
            f'({html.escape((t.get("arguments") or "")[:160])})</span></div>')


def render_turn(turn, source):
    first, last = turn[0], turn[-1]
    when = datetime.fromisoformat(first["time"]).strftime("%H:%M:%S")
    asked = first.get("user") or ""
    if source == "pipa":
        asked = asked[:160] + ("…" if len(asked) > 160 else "")
    who = {"you": "Você", "claude": "Claude", "pipa": "Tarefa"}[source]
    steps = "".join(f'<div class="step meta">↳ o modelo resumiu a página ({c.get("seconds", "?")} s)</div>'
                    if is_subcall(c) else "".join(tool_line(t) for t in c.get("tool_calls") or [])
                    for c in turn)
    reply = last.get("content") or ""
    used_tool = any(c.get("tool_calls") for c in turn)
    flag = ('<span class="flag">diz que fez algo sem chamar ferramenta</span>'
            if not used_tool and CLAIM.search(reply) else "")
    error = "".join(f'<div class="flag">erro: {html.escape(str(c["error"]))}</div>' for c in turn if c.get("error"))
    seconds = sum(c.get("seconds") or 0 for c in turn)
    usage = last.get("usage") or {}
    meta = (f'{when} · {len(turn)} chamada{"s" if len(turn) > 1 else ""} · {seconds:.1f} s · '
            f'{usage.get("prompt_tokens", "?")}→{usage.get("completion_tokens", "?")} tok')
    if first.get("system_prompt"):
        meta += f' · <a href="prompt/{html.escape(first["system_prompt"])}">prompt</a>'
    raw = "".join(f'<pre>{html.escape(json.dumps(c, ensure_ascii=False, indent=2))}</pre>' for c in turn)
    return (f'<div class="turn"><div class="meta">{meta}</div>'
            f'<div class="msg"><b>{who}:</b> {html.escape(asked[:600])}</div>{steps}'
            f'<div class="msg"><b>PiPA:</b> {html.escape(reply[:800])} {flag}</div>{error}'
            f'<details><summary>tudo o que foi enviado e recebido</summary>{raw}</details></div>')


def pause_banner():
    if not PAUSE.exists():
        return ""
    since = PAUSE.read_text().split()[0] if PAUSE.read_text().strip() else "?"
    return (f'<p class="flag" style="font-size:16px">⏸ PiPA pausada desde {html.escape(since)}: '
            f'não executa nada até receber "despausar".</p>')


def render(calls):
    blocks = blocks_of(sorted(calls, key=lambda c: c.get("time", "")))
    counts = {s: sum(1 for b in blocks if b["source"] == s) for s in SOURCES}
    filters = "".join(f'<label class="chip src-{s}"><input type="checkbox" data-filter="{s}" checked> '
                      f'{name} ({counts[s]})</label>' for s, name in SOURCES.items())
    sections = []
    for b in blocks:
        span = f'{b["first"]:%d/%m %H:%M}'
        if f'{b["last"]:%d/%m %H:%M}' != span:
            span += f'–{b["last"]:%H:%M}'
        n_calls = sum(len(t) for t in b["turns"])
        head = (f'<span class="who">{SOURCES[b["source"]]} · {html.escape(b["label"])}</span>'
                f'<span class="meta">{span} · {len(b["turns"])} mensage{"ns" if len(b["turns"]) > 1 else "m"}'
                f' · {n_calls} chamada{"s" if n_calls > 1 else ""}</span>')
        turns = "".join(render_turn(t, b["source"]) for t in b["turns"])
        sections.append(f'<section class="block src-{b["source"]}" data-source="{b["source"]}">'
                        f'<header>{head}</header>{turns}</section>')
    body = "".join(sections) or "<p>Nada registrado ainda.</p>"
    return (f'<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" '
            f'content="width=device-width, initial-scale=1"><title>PiPA: chamadas ao modelo</title>'
            f'<style>{PAGE_STYLE}</style></head><body><main><h1>PiPA: chamadas ao modelo</h1>{NAV}'
            f'{pause_banner()}<p class="sub">Conversas mais recentes primeiro. Cada bloco junta as mensagens de uma conversa '
            f'sem pausa maior que {GAP.seconds // 60} minutos; cada mensagem mostra as ferramentas que o '
            f'modelo chamou e a resposta final.</p><div class="filters">{filters}</div>{body}</main>'
            f'<script>{PAGE_SCRIPT}</script></body></html>')


