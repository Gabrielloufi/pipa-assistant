[Unit]
Description=PiPA: nanobot's gateway (Telegram, reminders, memory)
After=network-online.target pipa-llm-log.service
Wants=pipa-llm-log.service

[Service]
EnvironmentFile=%h/.config/pipa/secrets.env
ExecStart=%h/.local/share/pipa/venv/bin/nanobot gateway --foreground
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
